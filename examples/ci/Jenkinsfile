// Jenkins Pipeline for audioBridge Linux Virtual Audio Testing
//
// This pipeline automates audio loopback testing on Linux agents using:
// - ALSA snd-aloop kernel module for virtual audio devices
// - audioBridge-test CLI for test execution
// - JUnit XML report generation for test results visualization
//
// Usage:
// - Automatically runs on changes to main branch
// - Can be triggered manually with "Build with Parameters"
// - Supports parameterized builds for custom test suites

pipeline {
    agent any

    parameters {
        string(name: 'TEST_SUITE', defaultValue: 'default', description: 'Test suite to run')
        booleanParam(name: 'CONTINUE_ON_ERROR', defaultValue: false, description: 'Continue running tests after failure')
        choice(name: 'LOG_LEVEL', choices: ['info', 'debug', 'warn'], description: 'Logging level')
    }

    environment {
        TEST_SUITE = "${params.TEST_SUITE}"
        BUILD_DIR = 'build'
        TEST_RESULTS_DIR = 'test-results'
    }

    options {
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timestamps()
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    echo "========================================="
                    echo "  audioBridge Linux Audio Testing"
                    echo "========================================="
                    echo ""
                    echo "Test Suite: ${env.TEST_SUITE}"
                    echo "Log Level: ${params.LOG_LEVEL}"
                    echo "Continue on Error: ${params.CONTINUE_ON_ERROR}"
                    echo ""
                }

                sh '''
                    echo "Installing dependencies..."
                    sudo apt-get update -qq
                    sudo apt-get install -y \\
                        alsa-utils \\
                        sox \\
                        libsndfile1 \\
                        build-essential \\
                        cmake \\
                        git

                    echo "Loading snd-aloop kernel module..."
                    sudo modprobe snd-aloop
                    sudo lsmod | grep snd_aloop

                    echo "Verifying audio devices..."
                    aplay -l | grep -A 2 "Loopback" || echo "WARNING: No loopback devices found"
                '''
            }
        }

        stage('Build') {
            steps {
                dir('build') {
                    sh '''
                        echo "Configuring build..."
                        cmake .. || cmake ..

                        echo "Building audioBridge-test..."
                        make audioBridge-test
                    '''
                }
            }
        }

        stage('Generate Test Audio') {
            steps {
                sh '''
                    echo "Checking for test audio files..."
                    if [ ! -f "test-data/audio/1khz-sine.wav" ]; then
                        echo "Generating test audio..."
                        chmod +x scripts/utils/generate-test-audio.sh
                        ./scripts/utils/generate-test-audio.sh || echo "WARNING: Test audio generation failed"
                    else
                        echo "Test audio files exist"
                    fi
                '''
            }
        }

        stage('Setup Check') {
            steps {
                dir('build') {
                    sh './tests/tools/audioBridge-test setup-check'
                }
            }
        }

        stage('List Devices') {
            steps {
                dir('build') {
                    sh './tests/tools/audioBridge-test list-devices'
                    sh './tests/tools/audioBridge-test list-devices --type loopback --json'
                }
            }
        }

        stage('Run Single Test') {
            steps {
                dir('build') {
                    script {
                        if (fileExists("../test-data/audio/1khz-sine.wav")) {
                            sh './tests/tools/audioBridge-test run ../test-data/audio/1khz-sine.wav'
                        } else {
                            echo "WARNING: Test audio file not found, skipping single test"
                        }
                    }
                }
            }
        }

        stage('Run Test Suite') {
            steps {
                dir('build') {
                    // Create test results directory
                    sh 'mkdir -p ${TEST_RESULTS_DIR}'

                    script {
                        // Run test suite
                        def continueOnError = params.CONTINUE_ON_ERROR ? '--continue-on-error' : ''
                        sh "./tests/tools/audioBridge-test run-suite ${env.TEST_SUITE} ${continueOnError}"
                    }
                }
            }
        }

        stage('Publish Results') {
            steps {
                // Archive test results
                archiveArtifacts artifacts: 'build/test-results/**/*', fingerprint: true

                // Publish JUnit test results
                junit testResults: 'build/test-results/**/*.xml', allowEmptyResults: true

                // Add custom test report
                sh '''
                    mkdir -p ${TEST_RESULTS_DIR}
                    cat > ${TEST_RESULTS_DIR}/summary.txt <<EOF
                    audioBridge Test Report
                    =======================

                    Date: $(date -u +'%Y-%m-%d %H:%M:%S UTC')
                    Build: ${env.BUILD_NUMBER}
                    Test Suite: ${env.TEST_SUITE}
                    Platform: Linux (Jenkins)

                    For detailed results, see the test artifacts.
                    EOF
                    cat ${TEST_RESULTS_DIR}/summary.txt
                '''
            }
        }
    }

    post {
        always {
            // Clean up workspace
            echo 'Cleaning up...'
            sh 'sudo modprobe -r snd-aloop || true'
        }

        success {
            echo "========================================="
            echo "Pipeline SUCCESS: All tests passed!"
            echo "========================================="
        }

        failure {
            echo "========================================="
            echo "Pipeline FAILED: Some tests failed"
            echo "========================================="
        }

        unstable {
            echo "========================================="
            echo "Pipeline UNSTABLE: Tests had warnings"
            echo "========================================="
        }
    }
}
